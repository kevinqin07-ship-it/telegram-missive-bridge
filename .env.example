# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get this from Missive → Settings → API
MISSIVE_API_KEY=your_missive_api_key_here

# Optional: auto-assign incoming Telegram conversations to a specific Missive team
# Find your team ID in Missive → Settings → Teams
MISSIVE_TEAM_ID=

# Optional: a random secret string to validate incoming Missive webhooks
# Set the same value in Missive → Settings → Webhooks → Secret
WEBHOOK_SECRET=

# Postgres connection string — Railway injects this automatically when you add a Postgres addon
# For local development, use a local Postgres URL e.g.: postgresql://localhost:5432/telegram_missive
DATABASE_URL=

# Railway sets PORT automatically — you don't need to change this
PORT=3000
